{
    "name": "nic",
    "icon": "vm",
    "settings": {
    // ** BEGIN LAZYCODIUM BLOCK **
    // put this block at the top so users can override below
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    "nvim-ui.nvimColorCustomizationKeys": [
        "tab.activeBorder",
        "editorCursor.foreground",
        "panel.border",
        "panelTitle.activeBorder",
        "panelTitle.activeForeground",
        "statusBar.background",
        "activityBar.background"
    ],
    "nvim-ui.nvimColorNormal": "#2f2f2c",
    "nvim-ui.nvimColorInsert": "#660066",
    "nvim-ui.nvimColorVisual": "#908800",
    "nvim-ui.nvimColorReplace": "#665a00",
    // "editor.cursorBlinking": "expand",
    "vscode-neovim.neovimViewportHeightExtend": 1000,
    "vscode-neovim.ctrlKeysForInsertMode": [
        "a",
        "c",
        "d",
        "h",
        "j",
        "o",
        "r",
        "t",
        "u",
        "w",
        "l"
    ],
    // ** END LAZYCODIUM BLOCK **
    "workbench.editor.enablePreviewFromQuickOpen": true,
    "workbench.editor.enablePreview": true,
    // "workbench.sideBar.location": "right",
    "workbench.colorTheme": "Nord Dark Contrast",
    "workbench.iconTheme": "eq-material-theme-icons-ocean",
    "workbench.productIconTheme": "vscode-v1-icons",
    "[python]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "editor.codeActionsOnSave": {},
    "editor.formjatOnSave": true,
    "editor.smoothScrolling": false,
    "editor.stickyScroll.enabled": true,
    "editor.minimap.enabled": false,
    "workbench.activityBar.location": "bottom",
    "editor.fontLigatures": true,
    "editor.fontFamily": "JetBrainsMono Nerd Font",
    "editor.quickSuggestions": {
        "other": true,
        "comments": true,
        "strings": true
    },
    "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
    "terminal.integrated.enableImages": true,
    "window.zoomLevel": 2,
    "projectManager.git.baseFolders": [
        "~/projects",
        "/workspaces"
    ],
    "redhat.telemetry.enabled": false,
    "vs-kubernetes": {
        "vs-kubernetes.minikube-show-information-expiration": "2024-07-29T17:39:29.380Z"
    },
    "git.autofetch": true,
    "git.suggestSmartCommit": false,
    "git.confirmSync": false,
    "projectManager.git.ignoredFolders": [
        "node_modules",
        "out",
        "typings",
        "test",
        ".haxelib",
        ".venv"
    ],
    "projectManager.hg.maxDepthRecursion": 2,
    "python.createEnvironment.trigger": "off",
    "files.trimFinalNewlines": true,
    "ansible.executionEnvironment.containerEngine": "docker",
    "colorize.include": [
        "**/*.py",
        "**/*.json",
        "**/*.css",
        "**/*.scss",
        "**/*.sass",
        "**/*.less",
        "**/*.styl"
    ],
    "vscode-neovim.highlightGroups.highlights": {
        "IncSearch": {
            "backgroundColor": "theme.editor.findMatchBackground"
        },
        "CurSearch": {
            "backgroundColor": "theme.editor.findMatchBackground"
        },
        "Search": {
            "backgroundColor": "theme.editor.findMatchHighlightBackground"
        },
        "Substitute": {
            "backgroundColor": "theme.editor.foreground",
            "color": "theme.editor.background"
        }
    },
    "workbench.sideBar.location": "left",
    "workbench.colorCustomizations": {
        "tab.activeBorder": "#001e45",
        "editorCursor.foreground": "#001e45",
        "panel.border": "#001e45",
        "panelTitle.activeBorder": "#001e45",
        "panelTitle.activeForeground": "#001e45",
        "statusBar.background": "#001e45",
        "activityBar.background": "#001e45"
    }
},
    "keybindings": [
    // ** BEGIN LAZYCODIUM BLOCK **
    {
        "key": "ctrl+p",
        "command": "-workbench.action.quickOpen"
    },
    {
        "command": "-vscode-neovim.send",
        "key": "ctrl+d"
    },
    {
        "key": "ctrl+c",
        "command": "vscode-neovim.send",
        "when": "editorTextFocus && neovim.mode == visual",
        "args": "<C-c>"
    },
    {
        "key": "alt+k",
        "command": "vscode-neovim.send",
        "when": "editorTextFocus && neovim.mode == normal",
        "args": "<A-k>"
    },
    {
        "key": "alt+k",
        "command": "vscode-neovim.send",
        "when": "editorTextFocus && neovim.mode == visual",
        "args": "<A-k>"
    },
    {
        "key": "alt+j",
        "command": "vscode-neovim.send",
        "when": "editorTextFocus && neovim.mode == normal",
        "args": "<A-j>"
    },
    {
        "key": "alt+j",
        "command": "vscode-neovim.send",
        "when": "editorTextFocus && neovim.mode == visual",
        "args": "<A-j>"
    },
    {
        "key": "alt+k",
        "command": "vscode-neovim.send",
        "when": "editorTextFocus && neovim.mode == insert",
        "args": "<A-k>"
    },
    {
        "key": "alt+j",
        "command": "vscode-neovim.send",
        "when": "editorTextFocus && neovim.mode == insert",
        "args": "<A-j>"
    },
    {
        "key": "alt+p",
        "command": "vscode-neovim.send",
        "when": "editorTextFocus && neovim.mode == insert",
        "args": "<A-p>"
    },
    {
        "key": "ctrl+/",
        "command": "vscode-neovim.send",
        "when": "terminalFocus",
        "args": "<C-/>"
    },
    {
        "key": "ctrl+h",
        "command": "workbench.action.terminal.focusPreviousPane",
        "when": "terminalFocus",
    },
    {
        "key": "ctrl+l",
        "command": "workbench.action.terminal.focusNextPane",
        "when": "terminalFocus",
    },
    {
        "key": "ctrl+shift+h",
        "command": "workbench.action.terminal.focusPrevious",
        "when": "terminalFocus",
    },
    {
        "key": "ctrl+shift+l",
        "command": "workbench.action.terminal.focusNext",
        "when": "terminalFocus",
    },
    {
        "key": "ctrl+shift+t",
        "command": "workbench.action.terminal.newInActiveWorkspace",
        "when": "terminalFocus",
    },
    {
        "key": "space p f",
        "command": "workbench.action.quickOpen",
        "when": "editorTextFocus && neovim.mode == normal"
    },
    {
        "key": "space p w",
        "command": "workbench.action.findInFiles",
        "when": "editorTextFocus && neovim.mode == 'normal'"
    },
    {
        "key": "space c a",
        "command": "editor.action.codeAction",
        "when": "editorTextFocus && neovim.mode == 'normal'"
    },
    {
        "key": "space t t",
        "command": "workbench.action.togglePanel",
        // not perfect but it's not awful
        "when": "editorTextFocus && neovim.mode == 'normal' || problemsViewFocus"
    },
    {
        "key": "alt+o",
        "command": "workbench.action.nextPanelView"
    },
    {
        "key": "alt+i",
        "command": "workbench.action.previousPanelView"
    },
    {
        "key": "space p d",
        "command": "editor.action.triggerParameterHints",
        "when": "editorHasSignatureHelpProvider && editorTextFocus && neovim.mode == 'normal'"
    },
    {
        "key": "shift+k",
        "command": "editor.action.showHover",
        "when": "editorTextFocus && neovim.mode == 'normal'"
    },
    // this mimics lazyvim's space + e to open the file tree which isn't working natively right now...
    {
        "key": "space e",
        "command": "workbench.view.explorer",
        "when": "editorTextFocus && neovim.mode == 'normal'"
    },
    {
        "key": "space e",
        "command": "workbench.action.toggleSidebarVisibility",
        "when": "explorerViewletFocus && !terminalFocus && neovim.mode == 'normal'"
    },
    {
        "key": "ctrl+b e",
        "command": "workbench.view.explorer",
        "when": "terminalFocusInAny || explorerViewletFocus || editorFocus"
    },
    {
        "key": "ctrl+b e",
        "command": "workbench.action.toggleSidebarVisibility",
        "when": "explorerViewletVisible && filesExplorerFocus"
    },
    {
        "key": "space r",
        "command": "renameFile",
        "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
    },
    {
        "key": "enter",
        "command": "-renameFile",
        "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
    },
    {
        "key": "a",
        "command": "explorer.newFile",
        "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
    },
    {
        "key": "shift+a",
        "command": "explorer.newFolder",
        "when": "explorerViewletVisible && filesExplorerFocus && !inputFocus"
    },
    // window movement
    {
        "key": "ctrl+h",
        "command": "workbench.action.navigateLeft"
    },
    {
        "key": "ctrl+l",
        "command": "workbench.action.navigateRight"
    },
    {
        "key": "ctrl+j",
        "command": "workbench.action.navigateDown"
    },
    // tab movement
    {
        "key": "alt+h",
        "command": "workbench.action.previousEditor",
        "when": "!terminalFocus"
    },
    {
        "key": "alt+l",
        "command": "workbench.action.nextEditor",
        "when": "!terminalFocus"
    },
    // ** END LAZYCODIUM BLOCK **
    // zen... this one is nice
    {
        "key": "ctrl+k z",
        "command": "workbench.action.toggleZenMode"
    },
    // tmux like kepmaps for window/space navigation
    {
        "key": "ctrl+b h",
        "command": "workbench.action.navigateLeft"
    },
    {
        "key": "ctrl+b l",
        "command": "workbench.action.navigateRight"
    },
    {
        "key": "ctrl+b j",
        "command": "workbench.action.navigateDown"
    },
    {
        "key": "ctrl+b s",
        "command": "workbench.action.openRecent"
    },
    {
        "key": "ctrl+b ctrl+n",
        "command": "projectManager.listProjects"
    },
    {
        "key": "alt+cmd+p",
        "command": "-projectManager.listProjects"
    },
    // {
    //     "key": "ctrl+b -",
    //     "command": "workbench.action.terminal.newWithProfile",
    // },
    {
        "key": "ctrl+b t",
        // "command": "workbench.action.terminal.new"
        "command": "workbench.action.terminal.toggleTerminal"
    },
    {
        "key": "ctrl+b k",
        "command": "workbench.action.navigateUp",
        "when": "terminalFocus"
    },
    // {
    //     "key": "ctrl+shift+=",
    //     "command": "workbench.action.zoomIn"
    // },
    {
        "key": "ctrl+-",
        "command": "workbench.action.zoomOut"
    },
    {
        "key": "ctrl+b ctrl+c",
        // TODO: swap between machines
        // "command": "workbench.action.chat.openInSidebar"
        "command": "codeium.chatPanelView.focus"
    },
    // TODO: replace this with lazygit?
    {
        "key": "ctrl+b ctrl+k",
        "command": "workbench.view.scm",
        // "when": "editorTextFocus"
    },
    {
        "key": "ctrl+b ctrl+k",
        "command": "workbench.action.toggleSidebarVisibility",
        "when": "!editorFocus"
    },
    {
        "key": "ctrl+j",
        "command": "workbench.action.terminal.focusNext",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+k",
        "command": "workbench.action.terminal.focusPrevious",
        "when": "terminalFocus"
    },
    {
        "key": "ctrl+b z",
        "command": "workbench.action.toggleZenMode",
        "when": "editorFocus"
    },
    {
        "key": "ctrl+b z",
        "command": "workbench.action.toggleMaximizedPanel",
        "when": "terminalFocus"
    },
    // {
    //     "key": "tab",
    //     "command": "editor.action.inlineSuggest.showNext",
    //     "when": "inlineSuggestionVisible && editorTextFocus && !editorTabMovesFocus"
    // },
    {
        "key": "shift+tab",
        "command": "editor.action.inlineSuggest.showNext",
        "when": "inlineSuggestionVisible && editorTextFocus && !editorTabMovesFocus"
    },
    {
        "key": "ctrl+b ctrl+d",
        "command": "workbench.action.terminal.resizePaneDown"
    },
    {
        "key": "ctrl+b ctrl+u",
        "command": "workbench.action.terminal.resizePaneUp"
    },
    // quick open
    {
        "key": "ctrl+b g e s",
        "command": "workbench.action.openSettingsJson"
    },
    {
        "key": "ctrl+b g e k",
        "command": "workbench.action.openGlobalKeybindingsFile"
    },
    // general
    {
        "key": "shift+cmd+x",
        "command": "-workbench.view.extensions",
        "when": "viewContainer.workbench.view.extensions.enabled"
    },
    {
        "key": "space g s p",
        "command": "python.setInterpreter",
        "when": "editorTextFocus && neovim.mode == 'normal'"
    },
    // let me use nvim to edit commands in vscode terminal
    {
        "key": "ctrl+e",
        "command": "ctrl+e",
        "when": "terminalFocus"
    }
],
    "extensions": "[{\"identifier\":{\"id\":\"ahebrank.yaml2json\",\"uuid\":\"a4f0c51b-9bfb-4f23-b646-0d3bbbc40142\"},\"displayName\":\"YAML to JSON\"},{\"identifier\":{\"id\":\"aimery.wintercell\",\"uuid\":\"ce899d6a-bdbb-448d-b790-b87fe17921a4\"},\"displayName\":\"WinterCell\"},{\"identifier\":{\"id\":\"alefragnani.project-manager\",\"uuid\":\"1b747f06-3789-4ebd-ac99-f1fe430c3347\"},\"displayName\":\"Project Manager\"},{\"identifier\":{\"id\":\"charliermarsh.ruff\",\"uuid\":\"c2ca9b43-fa38-44fc-928e-5125970b9c00\"},\"displayName\":\"Ruff\"},{\"identifier\":{\"id\":\"codefactor.repo-status\",\"uuid\":\"f80d07e7-58a6-478c-b08f-40dcc4184596\"},\"displayName\":\"Repository status\"},{\"identifier\":{\"id\":\"codeium.codeium\",\"uuid\":\"acab4f40-b6db-42ec-bcd1-01802cbdd988\"},\"displayName\":\"Codeium: AI Coding Autocomplete and Chat for Python, Javascript, Typescript, Java, Go, and more\"},{\"identifier\":{\"id\":\"enkia.tokyo-night\",\"uuid\":\"1cac7443-911e-48b9-8341-49f3880c288a\"},\"displayName\":\"Tokyo Night\"},{\"identifier\":{\"id\":\"equinusocio.vsc-material-theme\",\"uuid\":\"45bfc9eb-5e03-487f-bffe-315fa6881d6a\"},\"displayName\":\"Material Theme — Free\"},{\"identifier\":{\"id\":\"equinusocio.vsc-material-theme-icons\",\"uuid\":\"6959958f-be4d-42c4-8aa4-dc2c2f086b0a\"},\"displayName\":\"Material Theme Icons — Free\"},{\"identifier\":{\"id\":\"erd0s.terraform-autocomplete\",\"uuid\":\"36bd7cbe-6e30-473f-bbdb-8952eaf40bc2\"},\"displayName\":\"Terraform Autocomplete\"},{\"identifier\":{\"id\":\"github.vscode-github-actions\",\"uuid\":\"04f49bfc-8330-4eee-8237-ea938fb755ef\"},\"displayName\":\"GitHub Actions\"},{\"identifier\":{\"id\":\"github.vscode-pull-request-github\",\"uuid\":\"69ddd764-339a-4ecc-97c1-9c4ece58e36d\"},\"displayName\":\"GitHub Pull Requests\"},{\"identifier\":{\"id\":\"gruntfuggly.todo-tree\",\"uuid\":\"261cac81-cd7b-4555-bb41-0c2d2bcd3e70\"},\"displayName\":\"Todo Tree\"},{\"identifier\":{\"id\":\"hashicorp.terraform\",\"uuid\":\"4a23294b-fd16-4c51-9759-da9936474cf8\"},\"displayName\":\"HashiCorp Terraform\"},{\"identifier\":{\"id\":\"kennylong.kubernetes-yaml-formatter\",\"uuid\":\"ff7ddaea-da15-4049-972f-4408841beffa\"},\"displayName\":\"Kubernetes YAML Formatter\"},{\"identifier\":{\"id\":\"mhutchie.git-graph\",\"uuid\":\"438221f8-1107-4ccd-a6fe-f3b7fe0856b7\"},\"displayName\":\"Git Graph\"},{\"identifier\":{\"id\":\"ms-azuretools.vscode-docker\",\"uuid\":\"0479fc1c-3d67-49f9-b087-fb9069afe48f\"},\"displayName\":\"Docker\"},{\"identifier\":{\"id\":\"ms-kubernetes-tools.vscode-kubernetes-tools\",\"uuid\":\"4837e4f3-1b01-4732-b1a6-daa57ef64cab\"},\"displayName\":\"Kubernetes\"},{\"identifier\":{\"id\":\"ms-python.debugpy\",\"uuid\":\"4bd5d2c9-9d65-401a-b0b2-7498d9f17615\"},\"displayName\":\"Python Debugger\"},{\"identifier\":{\"id\":\"ms-python.python\",\"uuid\":\"f1f59ae4-9318-4f3c-a9b5-81b2eaa5f8a5\"},\"displayName\":\"Python\"},{\"identifier\":{\"id\":\"ms-python.vscode-pylance\",\"uuid\":\"364d2426-116a-433a-a5d8-a5098dc3afbd\"},\"displayName\":\"Pylance\"},{\"identifier\":{\"id\":\"ms-vscode-remote.remote-containers\",\"uuid\":\"93ce222b-5f6f-49b7-9ab1-a0463c6238df\"},\"displayName\":\"Dev Containers\"},{\"identifier\":{\"id\":\"redhat.ansible\",\"uuid\":\"f8cb4642-bc5c-46a1-be34-0977e817406c\"},\"displayName\":\"Ansible\"},{\"identifier\":{\"id\":\"redhat.vscode-yaml\",\"uuid\":\"2061917f-f76a-458a-8da9-f162de22b97e\"},\"displayName\":\"YAML\"},{\"identifier\":{\"id\":\"rubymaniac.vscode-direnv\",\"uuid\":\"faff79ea-83b6-4e20-9fcc-d74dacc491b5\"},\"displayName\":\"direnv\"},{\"identifier\":{\"id\":\"sf-core-ides.blueberry-cider\",\"uuid\":\"276087d6-7598-4cfa-be29-927553b47866\"},\"displayName\":\"Cider Blues\"},{\"identifier\":{\"id\":\"siris01.catppuccin-theme\",\"uuid\":\"23b56bbf-7be8-4a89-b3ae-85ca25fec971\"},\"displayName\":\"Catppuccin vscode theme\"},{\"identifier\":{\"id\":\"tamasfe.even-better-toml\",\"uuid\":\"b2215d5f-675e-4a2b-b6ac-1ca737518b78\"},\"displayName\":\"Even Better TOML\"},{\"identifier\":{\"id\":\"tomoki1207.selectline-statusbar\",\"uuid\":\"4e1273ba-8871-42e2-8bc2-01dd29ebf16b\"},\"displayName\":\"Select Line Status Bar\"},{\"identifier\":{\"id\":\"vscodevim.vim\",\"uuid\":\"d96e79c6-8b25-4be3-8545-0e0ecefcae03\"},\"displayName\":\"Vim\"},{\"identifier\":{\"id\":\"whosydd.carbon\",\"uuid\":\"19dcf37d-a71a-4d9e-9987-c7cccefda5ee\"},\"displayName\":\"Carbon\"},{\"identifier\":{\"id\":\"ybaumes.highlight-trailing-white-spaces\",\"uuid\":\"0fcbe507-6af5-4c42-8cc6-8044625d4edf\"},\"displayName\":\"Highlight Trailing White Spaces\"}]",
