#! /bin/bash
# pick multiple emails from list and combine into comma separated array
# emails=`cat ~/dotfiles/work/.caterpillar/emails | fzf -m | sed 's/^\|$/"/g'|paste -sd,`

read -p "Pick reviewers (hit enter)"
emails=`cat ~/dotfiles/iron/.caterpillar/emails | fzf -m | sed 's/^\|$//g'|paste -sd,`

echo "PR Title: "
read title
title=${title:-$(git rev-parse --symbolic-full-name --abbrev-ref HEAD)}

echo "Target Branch: "
read target
target=${target:-"main"}

echo "Squash? ([y]/n): "
read squash
if [ "$squash" = "y" ]
then
    squash="--squash"
else
    squash=""
fi

echo "Draft? ([y]/n): "
read draft
if [ "$draft" = "y" ]
then
    draft="--draft"
else
    draft=""
fi

# echo "az repos pr create -o table --target-branch $target --title $title --reviewers \"$emails\" $squash $draft" | xclip -sel clip
`az repos pr create -o table --target-branch $target --title "$title" --reviewers \"$emails\" $squash $draft`