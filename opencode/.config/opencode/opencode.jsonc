{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-notify", "background-agents", "nexus-plugin"],
  "model": "github-copilot/gpt-5.2-codex",
  "small_model": "github-copilot/gpt-5.1-codex-mini",

  // Alternative models you can swap in:
  // "model": "github-copilot/gpt-5.2",
  // "model": "github-copilot/o3-mini",  // codex-style reasoning
  // "model": "github-copilot/claude-sonnet-4-5",

  // Configure subagents to use specific models
  "agent": {
    "plan": {
      "model": "github-copilot/claude-opus-4.6",
    },
    "build": {
      "model": "github-copilot/gpt-5.2-codex",
    },
  },

  "permission": {
    "edit": "allow",
    "bash": {
      // Read-only allows
      "uv *": "allow",
      "ruff *": "allow",
      "python *": "allow",
      "pytest *": "allow",
      "just *": "ask",

      "git status": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git show*": "allow",
      "git remote -v": "allow",
      "git rev-parse*": "allow",
      "git worktree list": "allow",
      "git fetch": "allow",
      "git clone": "allow",
      "git pull": "allow",

      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "fd *": "allow",
      "tree *": "allow",
      "wc *": "allow",
      "pwd": "allow",
      "which *": "allow",
      "whoami": "allow",
      "echo *": "allow",
      "env": "allow",
      "printenv*": "allow",
      "jq *": "allow",
      "yq *": "allow",
      "tar -tf *": "allow",
      "tar -tzf *": "allow",
      "unzip -l *": "allow",

      "nexus --help*": "allow",
      "nexus * --help*": "allow",
      "nexus status*": "allow",
      "nexus next --format*": "allow",
      "nexus next --json*": "allow",
      "nexus issue list*": "allow",
      "nexus issue show*": "allow",
      "nexus plan list*": "allow",
      "nexus plan show*": "allow",

      "helm version*": "allow",
      "helm list*": "allow",
      "helm status*": "allow",
      "helm get *": "allow",
      "helm history*": "allow",
      "helm show*": "allow",
      "helm search*": "allow",
      "helm template*": "allow",
      "helm repo list*": "allow",
      "helm dependency list*": "allow",
      "helm env*": "allow",
      "helm lint*": "allow",

      "kubectl-ics-dev get*": "allow",
      "kubectl-ics-dev describe*": "allow",
      "kubectl-ics-dev logs*": "allow",
      "kubectl-ics-dev explain*": "allow",
      "kubectl-ics-dev api-resources*": "allow",
      "kubectl-ics-dev api-versions*": "allow",
      "kubectl-ics-dev config view*": "allow",
      "kubectl-ics-dev config get-contexts*": "allow",
      "kubectl-ics-dev config current-context*": "allow",
      "kubectl-ics-dev cluster-info*": "allow",
      "kubectl-ics-dev version*": "allow",
      "kubectl-ics-dev top*": "allow",
      "kubectl-ics-dev auth can-i*": "allow",
      "kubectl-ics-dev diff*": "allow",
      "kubectl-ics-dev kustomize*": "allow",

      "kubectl-ics-prod get*": "allow",
      "kubectl-ics-prod describe*": "allow",
      "kubectl-ics-prod logs*": "allow",
      "kubectl-ics-prod explain*": "allow",
      "kubectl-ics-prod api-resources*": "allow",
      "kubectl-ics-prod api-versions*": "allow",
      "kubectl-ics-prod config view*": "allow",
      "kubectl-ics-prod config get-contexts*": "allow",
      "kubectl-ics-prod config current-context*": "allow",
      "kubectl-ics-prod cluster-info*": "allow",
      "kubectl-ics-prod version*": "allow",
      "kubectl-ics-prod top*": "allow",
      "kubectl-ics-prod auth can-i*": "allow",
      "kubectl-ics-prod diff*": "allow",
      "kubectl-ics-prod kustomize*": "allow",
      "kubecm *": "allow",

      "docker ps*": "allow",
      "docker images*": "allow",
      "docker logs*": "allow",
      "docker inspect*": "allow",
      "docker volume ls*": "allow",
      "docker network ls*": "allow",
      "docker version": "allow",
      "docker info": "allow",
      "docker compose ps*": "allow",
      "docker compose logs*": "allow",
      "docker compose config*": "allow",

      "terraform plan*": "allow",
      "terraform show*": "allow",
      "terraform state list*": "allow",
      "terraform state show*": "allow",
      "terraform providers*": "allow",
      "terraform version": "allow",
      "terraform output*": "allow",

      "tofu plan*": "allow",
      "tofu validate*": "allow",
      "tofu fmt*": "allow",
      "tofu show*": "allow",
      "tofu state list*": "allow",
      "tofu state show*": "allow",
      "tofu providers*": "allow",
      "tofu version": "allow",
      "tofu output*": "allow",

      // AWS: default ask, then specific read-only allows override
      "aws *": "ask",
      "aws sts get-caller-identity*": "allow",
      "aws configure list*": "allow",
      "aws s3 ls*": "allow",
      "aws s3api list-*": "allow",
      "aws s3api get-*": "allow",
      "aws s3api head-*": "allow",
      "aws ec2 describe-*": "allow",
      "aws eks list-*": "allow",
      "aws eks describe-*": "allow",
      "aws iam list-*": "allow",
      "aws iam get-*": "allow",
      "aws logs describe-*": "allow",
      "aws logs get-*": "allow",
      "aws logs filter-log-events*": "allow",
      "aws logs tail*": "allow",
      "aws cloudwatch get-*": "allow",
      "aws cloudwatch list-*": "allow",
      "aws ssm describe-*": "allow",
      "aws lambda list-*": "allow",
      "aws lambda get-*": "allow",
      "aws rds describe-*": "allow",
      "aws fsx describe-*": "allow",
      "aws fsx list-*": "allow",
      "aws secretsmanager list-*": "allow",
      "aws cloudformation describe-*": "allow",
      "aws cloudformation list-*": "allow",
      "aws route53 list-*": "allow",
      "aws route53 get-*": "allow",
      "aws organizations describe-*": "allow",
      "aws organizations list-*": "allow",
      "aws autoscaling describe-*": "allow",
      "aws elbv2 describe-*": "allow",
      "aws ecs describe-*": "allow",
      "aws ecs list-*": "allow",
      "aws ecr describe-*": "allow",
      "aws ecr list-*": "allow",
      "aws batch describe-*": "allow",

      "steampipe --version": "allow",
      "steampipe query*": "allow",

      "go version": "allow",
      "go env": "allow",
      "go env -json*": "allow",
      "go list*": "allow",
      "go help*": "allow",
      "go doc*": "allow",
      "go mod graph*": "allow",
      "go mod why*": "allow",

      "npm list*": "allow",
      "npm outdated*": "allow",
      "npm view*": "allow",
      "npm --version": "allow",
      "node --version": "allow",
      "bun pm ls*": "allow",
      "bun --version": "allow",
      "pnpm list*": "allow",
      "pnpm outdated*": "allow",
      "pnpm --version": "allow",
      "yarn list*": "allow",
      "yarn --version": "allow",

      "uv --version": "allow",
      "uv python list*": "allow",
      "uv pip list*": "allow",
      "uv pip show*": "allow",
      "uv pip freeze*": "allow",
      "uv pip tree*": "allow",
      "uv pip check*": "allow",
      "uv tool list*": "allow",
      "uv cache dir*": "allow",

      // Mutations (ask)
      "nexus next --claim*": "ask",
      "nexus issue create*": "ask",
      "nexus issue update*": "ask",
      "nexus issue edit*": "ask",
      "nexus issue claim*": "ask",
      "nexus issue renew*": "ask",
      "nexus issue release*": "ask",
      "nexus issue force-release*": "ask",
      "nexus issue complete*": "ask",
      "nexus issue duplicate*": "ask",
      "nexus issue delete*": "ask",
      "nexus issue prune*": "ask",
      "nexus plan create*": "ask",
      "nexus plan update*": "ask",
      "nexus plan edit*": "ask",

      "git add*": "ask",
      "git commit*": "ask",
      "git push*": "ask",
      "git checkout*": "ask",
      "git merge*": "ask",
      "git rebase*": "ask",
      "git reset*": "ask",
      "git worktree add*": "ask",
      "git worktree remove*": "ask",
      "git worktree prune*": "ask",

      "gh pr list*": "allow",
      "gh pr status*": "allow",
      "gh pr diff*": "allow",
      "gh pr checks*": "allow",
      "gh pr view*": "allow",
      "gh pr checkout*": "ask",
      "gh pr create*": "ask",
      "gh pr close*": "ask",
      "gh pr comment*": "ask",
      "gh pr edit*": "ask",
      "gh pr lock*": "ask",
      "gh pr merge*": "ask",
      "gh pr ready*": "ask",
      "gh pr reopen*": "ask",
      "gh pr revert*": "ask",
      "gh pr review*": "ask",
      "gh pr unlock*": "ask",
      "gh pr update-branch*": "ask",

      "helm install*": "ask",
      "helm upgrade*": "ask",
      "helm uninstall*": "ask",
      "helm rollback*": "ask",

      "kubectl-ics-dev apply*": "ask",
      "kubectl-ics-dev delete*": "ask",
      "kubectl-ics-dev edit*": "ask",
      "kubectl-ics-dev patch*": "ask",
      "kubectl-ics-dev exec*": "ask",
      "kubectl-ics-dev port-forward*": "ask",

      "tofu apply*": "ask",
      "tofu destroy*": "ask",
      "tofu import*": "ask",
      "tofu state rm*": "ask",

      "docker run*": "ask",
      "docker build*": "ask",
      "docker exec*": "ask",
      "docker rm*": "ask",
      "docker stop*": "ask",
      "docker kill*": "ask",
      "docker push*": "ask",
      "docker pull*": "ask",
      "docker compose up*": "ask",
      "docker compose down*": "ask",
      "docker compose build*": "ask",
      "docker compose exec*": "ask",
      "docker compose rm*": "ask",

      // AWS mutations (specific patterns only - broad "aws *" catch-all is above)
      "aws sts assume-role*": "ask",
      "aws s3 cp*": "ask",
      "aws s3 rm*": "ask",
      "aws s3 sync*": "ask",
      "aws s3 mb*": "ask",
      "aws s3 rb*": "ask",
      "aws ssm get-parameter*": "ask",
      "aws secretsmanager get-*": "ask",

      "rm -rf *": "ask",

      // Hard denies
      "rm -rf /*": "deny",
      "sudo *": "deny",
      "> /dev/*": "deny",
    },
    "webfetch": "allow",
    "doom_loop": "ask",
    "external_directory": {
      "/Users/paynen3/projects/nexus.workspaces": "allow",
      "/Users/paynen3/projects/nexus.workspaces/*": "allow",
    },
  },

  "mcp": {
    "microsoft-azure-devops-mcp": {
      "type": "local",
      "command": ["npx", "-y", "@azure-devops/mcp@latest", "cat-aa"],
      "enabled": false,
    },
    "mcp-server-docker": {
      "type": "local",
      "command": ["uvx", "mcp-server-docker"],
      "enabled": false,
    },
    "linux-observability": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "/var/home/nic/projects/personal/linux-mcp-server/linux_mcp_server.py",
      ],
      "enabled": false,
      "environment": {
        "ALERT_ENDPOINT": "",
      },
    },
    "firefox-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "firefox-devtools-mcp@latest",
        "--headless",
        "--viewport",
        "1280x720",
      ],
      "environment": {
        "START_URL": "about:home",
      },
      "enabled": false,
    },
    "steampipe": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@turbot/steampipe-mcp",
        "postgresql://steampipe@localhost:9193/steampipe",
      ],
      "enabled": false,
    },
    "PieGPT": {
      "type": "remote",
      "url": "https://piegpt-mcp.ocala.k8s.dev.global.avant.com/sse",
      "timeout": 600,
      "enabled": false,
    },
    "spacectl": {
      "type": "local",
      "command": ["spacectl", "mcp", "server"],
      "enabled": false,
    },
    "git": {
      "command": ["uvx", "mcp-server-git"],
      "type": "local",
      "enabled": false,
    },
    "drawio": {
      "type": "local",
      "command": ["npx", "@next-ai-drawio/mcp-server@latest"],
      "environment": {
        "DRAWIO_BASE_URL": "http://localhost:8098",
      },
      "enabled": false,
    },
  },
}
