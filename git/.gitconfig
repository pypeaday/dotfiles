[user]
    name = pypeaday
    email = github@pype.aleeas.com

[credential]
    helper = store

[core]
    editor = nvim

[includeIf "gitdir:~/work/"]
        path = ~/.gitconfig-work
[includeIf "gitdir:~/personal/"]
        path = ~/.gitconfig-personal
[includeIf "gitdir:~/minionai/"]
        path = ~/.gitconfig-minionai
[init]
    defaultBranch = main
[push]
    default = current
