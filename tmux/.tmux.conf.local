# =============================================================================
# TMUX CONFIGURATION - ORGANIZED FOR EASY CUSTOMIZATION
# =============================================================================
# Based on gpakosz/.tmux with custom modifications
# This file is designed to be easy to understand and modify

# =============================================================================
# GENERAL SETTINGS
# =============================================================================

# Increase history size
set -g history-limit 10000

# Start with mouse mode enabled (uncomment to enable)
# set -g mouse on

# =============================================================================
# SESSION CREATION SETTINGS
# =============================================================================

# Prompt for session name when creating a new session
# Options: true, false (default), disabled
tmux_conf_new_session_prompt=false

# =============================================================================
# WINDOW & PANE CREATION SETTINGS
# =============================================================================

# New window retains current path
# Options: true, false (default), disabled
tmux_conf_new_window_retain_current_path=false

# New window tries to reconnect ssh sessions
# Options: true, false (default), disabled
tmux_conf_new_window_reconnect_ssh=false

# New pane retains current path
# Options: true (default), false, disabled
tmux_conf_new_pane_retain_current_path=true

# New pane tries to reconnect ssh sessions
# Options: true, false (default), disabled
tmux_conf_new_pane_reconnect_ssh=false

# =============================================================================
# DISPLAY SETTINGS
# =============================================================================

# RGB 24-bit color support
# Options: true, false, auto (default)
tmux_conf_24b_colour=auto

# =============================================================================
# THEMING SETTINGS
# =============================================================================

# Enable or disable theming
# Options: enabled (default), disabled
tmux_conf_theme=enabled

# Custom color scheme - pseudo vim-airline night own theme
# These colors control various aspects of the tmux interface
tmux_conf_theme_colour_1="#282c34"    # gui_black  # middle status bar background
tmux_conf_theme_colour_2="#282c34"    # gui_black  # inactive window bg
tmux_conf_theme_colour_3="#484e5a"    # light gray  # no idea
tmux_conf_theme_colour_4="#83DCC8"    # gui_cyan  # active window bg AND inactive window txt
tmux_conf_theme_colour_5="#c792ea"    # gui_purple  # command bar flash
tmux_conf_theme_colour_6="#282c34"    # gui_black  # session name text
tmux_conf_theme_colour_7="#83DCC8"    # gui_cyan  # uptime text
tmux_conf_theme_colour_8="#282c34"    # gui_black  # no idea
tmux_conf_theme_colour_9="#83DCC8"    # gui_cyan  # hostname bg
tmux_conf_theme_colour_10="#484e5a"   # light gray  # uptime bg
tmux_conf_theme_colour_11="#afd75f"   # gui_green  # command bar
tmux_conf_theme_colour_12="#83DCC8"   # gui_cyan  # time/date
tmux_conf_theme_colour_13="#83DCC8"   # gui_cyan  # username text
tmux_conf_theme_colour_14="#282c34"   # gui_black  # hostname text
tmux_conf_theme_colour_15="#282c34"   # gui_black  # time/date ribbon bg
tmux_conf_theme_colour_16="#484e5a"   # light gray  # username bg
tmux_conf_theme_colour_17="#83DCC8"   # gui_cyan  # hostname

# Window style
tmux_conf_theme_window_fg="default"
tmux_conf_theme_window_bg="default"

# Highlight focused pane
# Options: true, false (default)
tmux_conf_theme_highlight_focused_pane=false

# Focused pane colors
tmux_conf_theme_focused_pane_bg="$tmux_conf_theme_colour_2"

# Pane border style
# Options: thin (default), fat
tmux_conf_theme_pane_border_style=thin

# Pane borders colors
tmux_conf_theme_pane_border="$tmux_conf_theme_colour_2"
tmux_conf_theme_pane_active_border="$tmux_conf_theme_colour_4"
%if #{>=:#{version},3.2}
tmux_conf_theme_pane_active_border="#{?pane_in_mode,$tmux_conf_theme_colour_9,#{?synchronize-panes,$tmux_conf_theme_colour_16,$tmux_conf_theme_colour_4}}"
%endif

# Pane indicator colors (when you hit <prefix> + q)
tmux_conf_theme_pane_indicator="$tmux_conf_theme_colour_4"
tmux_conf_theme_pane_active_indicator="$tmux_conf_theme_colour_4"

# Status line style
tmux_conf_theme_message_fg="$tmux_conf_theme_colour_1"
tmux_conf_theme_message_bg="$tmux_conf_theme_colour_5"
tmux_conf_theme_message_attr="bold"

# Status line command style (<prefix> : Escape)
tmux_conf_theme_message_command_fg="$tmux_conf_theme_colour_5"
tmux_conf_theme_message_command_bg="$tmux_conf_theme_colour_1"
tmux_conf_theme_message_command_attr="bold"

# Window modes style
tmux_conf_theme_mode_fg="$tmux_conf_theme_colour_1"
tmux_conf_theme_mode_bg="$tmux_conf_theme_colour_5"
tmux_conf_theme_mode_attr="bold"

# Status line style
tmux_conf_theme_status_fg="$tmux_conf_theme_colour_3"
tmux_conf_theme_status_bg="$tmux_conf_theme_colour_1"
tmux_conf_theme_status_attr="none"

# Terminal title format
tmux_conf_theme_terminal_title="#h ❐ #S ● #I #W"

# Window status style
tmux_conf_theme_window_status_fg="$tmux_conf_theme_colour_3"
tmux_conf_theme_window_status_bg="$tmux_conf_theme_colour_1"
tmux_conf_theme_window_status_attr="none"
tmux_conf_theme_window_status_format="#I #W#{?#{||:#{window_bell_flag},#{window_zoomed_flag}}, ,}#{?window_bell_flag,!,}#{?window_zoomed_flag,Z,}"

# Window current status style
tmux_conf_theme_window_status_current_fg="$tmux_conf_theme_colour_1"
tmux_conf_theme_window_status_current_bg="$tmux_conf_theme_colour_4"
tmux_conf_theme_window_status_current_attr="bold"
tmux_conf_theme_window_status_current_format="#I #W#{?#{||:#{window_bell_flag},#{window_zoomed_flag}}, ,}#{?window_bell_flag,!,}#{?window_zoomed_flag,Z,}"

# Window activity status style
tmux_conf_theme_window_status_activity_fg="default"
tmux_conf_theme_window_status_activity_bg="default"
tmux_conf_theme_window_status_activity_attr="underscore"

# Window bell status style
tmux_conf_theme_window_status_bell_fg="$tmux_conf_theme_colour_5"
tmux_conf_theme_window_status_bell_bg="default"
tmux_conf_theme_window_status_bell_attr="blink,bold"

# Window last status style
tmux_conf_theme_window_status_last_fg="$tmux_conf_theme_colour_4"
tmux_conf_theme_window_status_last_bg="$tmux_conf_theme_colour_2"
tmux_conf_theme_window_status_last_attr="none"

# Status left/right sections separators
tmux_conf_theme_left_separator_main='\uE0B0'  # Powerline symbol
tmux_conf_theme_left_separator_sub='\uE0B1'   # Powerline symbol
tmux_conf_theme_right_separator_main='\uE0B2' # Powerline symbol
tmux_conf_theme_right_separator_sub='\uE0B3'  # Powerline symbol

# Status left/right content
tmux_conf_theme_status_left=" ❐ #S | ↑#{?uptime_y, #{uptime_y}y,}#{?uptime_d, #{uptime_d}d,}#{?uptime_h, #{uptime_h}h,}#{?uptime_m, #{uptime_m}m,} "
tmux_conf_theme_status_right=" #{prefix}#{mouse}#{pairing}#{synchronized}#{?battery_status,#{battery_status},}#{?battery_bar, #{battery_bar},}#{?battery_percentage, #{battery_percentage},} , %R , %d %b | #{username}#{root} | #{hostname} "

# Status left style
tmux_conf_theme_status_left_fg="$tmux_conf_theme_colour_6,$tmux_conf_theme_colour_7,$tmux_conf_theme_colour_8"
tmux_conf_theme_status_left_bg="$tmux_conf_theme_colour_9,$tmux_conf_theme_colour_10,$tmux_conf_theme_colour_11"
tmux_conf_theme_status_left_attr="bold,none,none"

# Status right style
tmux_conf_theme_status_right_fg="$tmux_conf_theme_colour_12,$tmux_conf_theme_colour_13,$tmux_conf_theme_colour_14"
tmux_conf_theme_status_right_bg="$tmux_conf_theme_colour_15,$tmux_conf_theme_colour_16,$tmux_conf_theme_colour_17"
tmux_conf_theme_status_right_attr="none,none,bold"

# =============================================================================
# INDICATOR SETTINGS
# =============================================================================

# Pairing indicator
tmux_conf_theme_pairing="⚇"                 # U+2687
tmux_conf_theme_pairing_fg="none"
tmux_conf_theme_pairing_bg="none"
tmux_conf_theme_pairing_attr="none"

# Prefix indicator
tmux_conf_theme_prefix="⌨"                  # U+2328
tmux_conf_theme_prefix_fg="none"
tmux_conf_theme_prefix_bg="none"
tmux_conf_theme_prefix_attr="none"

# Mouse indicator
tmux_conf_theme_mouse="↗"                   # U+2197
tmux_conf_theme_mouse_fg="none"
tmux_conf_theme_mouse_bg="none"
tmux_conf_theme_mouse_attr="none"

# Root indicator
tmux_conf_theme_root="!"
tmux_conf_theme_root_fg="none"
tmux_conf_theme_root_bg="none"
tmux_conf_theme_root_attr="bold,blink"

# Synchronized indicator
tmux_conf_theme_synchronized="⚏"            # U+268F
tmux_conf_theme_synchronized_fg="none"
tmux_conf_theme_synchronized_bg="none"
tmux_conf_theme_synchronized_attr="none"

# =============================================================================
# BATTERY SETTINGS
# =============================================================================

# Battery bar symbols
tmux_conf_battery_bar_symbol_full="◼"
tmux_conf_battery_bar_symbol_empty="◻"

# Battery bar length
tmux_conf_battery_bar_length="auto"

# Battery bar palette
tmux_conf_battery_bar_palette="gradient"

# Battery hbar palette
tmux_conf_battery_hbar_palette="gradient"

# Battery vbar palette
tmux_conf_battery_vbar_palette="gradient"

# Battery status symbols
tmux_conf_battery_status_charging="↑"       # U+2191
tmux_conf_battery_status_discharging="↓"    # U+2193

# =============================================================================
# CLOCK SETTINGS
# =============================================================================

# Clock style (when you hit <prefix> + t)
tmux_conf_theme_clock_colour="$tmux_conf_theme_colour_4"
tmux_conf_theme_clock_style="24"

# =============================================================================
# CLIPBOARD SETTINGS
# =============================================================================

# Copy to OS clipboard in copy mode
# Options: true, false (default), disabled
tmux_conf_copy_to_os_clipboard=true

# =============================================================================
# KEYBINDINGS - CURRENT CONFIGURATION
# =============================================================================
# This section documents the current keybindings for reference
# To revert to defaults, you can comment out or remove these lines

# PREFIX KEYS
# -----------
# Default prefix: C-b
# Additional prefix: C-a (GNU Screen compatible)
# To use only C-a, uncomment these lines:
# set -gu prefix2
# unbind C-a
# unbind C-b
# set -g prefix C-a
# bind C-a send-prefix

# WINDOW NAVIGATION
# ----------------
# C-h: previous window (non-default)
# C-l: next window (non-default)
# Tab: last active window (non-default)
# To revert to defaults, uncomment:
# unbind -r C-h
# unbind -r C-l
# unbind Tab
# bind -r n next-window
# bind -r p previous-window

# PANE NAVIGATION
# --------------
# h, j, k, l: vim-style pane navigation (non-default)
# >, <: swap panes (non-default)
# To revert to defaults, uncomment:
# unbind -r h
# unbind -r j
# unbind -r k
# unbind -r l
# unbind >
# unbind <
# bind Up select-pane -U
# bind Down select-pane -D
# bind Left select-pane -L
# bind Right select-pane -R

# PANE RESIZING
# ------------
# H, J, K, L: resize panes (non-default)
# To revert to defaults, uncomment:
# unbind -r H
# unbind -r J
# unbind -r K
# unbind -r L
# bind -r C-Up resize-pane -U 2
# bind -r C-Down resize-pane -D 2
# bind -r C-Left resize-pane -L 2
# bind -r C-Right resize-pane -R 2

# WINDOW SPLITTING
# --------------
# -: split horizontally (non-default)
# _: split vertically (non-default)
# To revert to defaults, uncomment:
# unbind -
# unbind _
# bind '"' split-window -v
# bind % split-window -h

# OTHER KEYBINDINGS
# ---------------
# +: maximize pane (non-default)
# m: toggle mouse mode (non-default)
# e: edit configuration (non-default)
# r: reload configuration (non-default)
# U: urlview (non-default)
# F: Facebook PathPicker (non-default)
# Enter: enter copy mode (non-default)

# =============================================================================
# USER CUSTOMIZATIONS
# =============================================================================
# Add your custom overrides below this line
# These will take precedence over the default settings

# Example: Force Vi mode
# set -g status-keys vi
# set -g mode-keys vi

# Example: Move status line to top
# set -g status-position top
