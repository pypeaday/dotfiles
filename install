#!/usr/bin/env bash
pushd $HOME/dotfiles

for package in zsh git gitui ipython nvim pip pyflyby starship ta tmux visidata
do
	stow -D $package || true
	stow $package
done

if [[ $USER == *"3"* ]]; then
	stow -D iron
	stow iron
elif [[ $USER == *"81"* ]]; then
	stow -D fin
	stow fin
else
	# pass since I'm at home
	echo "Skipping..."
fi

popd